# Copy to apps/ai-service/.env (gitignored) to use a real model with `pnpm dev` and
# `pnpm eval`. Without a .env the mock provider is used. Variables set on the command
# line win over this file. `pnpm start` and the E2E suite never read it.

AI_PROVIDER=openai

# Any OpenAI-compatible Chat Completions endpoint. Examples:
#   https://api.openai.com/v1                                  (default)
#   https://generativelanguage.googleapis.com/v1beta/openai    (Google Gemini)
#   http://localhost:11434/v1                                  (Ollama, local)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=

# Output limit per answer (default 600). Models that reason before answering spend it on
# reasoning too: raise it if answers stop at the length limit.
# OPENAI_MAX_OUTPUT_TOKENS=2000
