{
  "name": "@pulsedesk/ai-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "AI_DEBUG=1 node --env-file-if-exists=.env --watch --enable-source-maps src/main.ts",
    "start": "node src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=.env src/evaluation/run.ts"
  },
  "dependencies": {
    "@pulsedesk/contracts": "workspace:*",
    "@pulsedesk/observability": "workspace:*"
  },
  "devDependencies": {
    "@pulsedesk/eslint-config": "workspace:*",
    "@pulsedesk/typescript-config": "workspace:*",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
