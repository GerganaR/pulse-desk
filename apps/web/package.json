{
  "name": "@pulsedesk/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "rspack build -c rspack.client.config.ts --node-env production",
    "build:server": "rspack build -c rspack.server.config.ts --node-env production",
    "start": "node --enable-source-maps dist/server/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pulsedesk/contracts": "workspace:*",
    "@pulsedesk/ui": "workspace:*",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@pulsedesk/eslint-config": "workspace:*",
    "@pulsedesk/typescript-config": "workspace:*",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "globals": "^17.12.0"
  }
}
