{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.{ts,tsx}", "!**/*.md"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "CLIENT_DEV_PORT"]
    },
    "build:devtools": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.{ts,tsx}", "!**/*.md"],
      "outputs": ["dist-devtools/**"],
      "env": ["NODE_ENV", "CLIENT_DEV_PORT"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "CLIENT_DEV_PORT",
        "PUBLIC_GATEWAY_URL",
        "GATEWAY_HTTP_URL",
        "SSR_TIMEOUT_MS",
        "SSR_DATA_BUDGET_MS",
        "GATEWAY_PORT",
        "GATEWAY_HOST",
        "REPLAY_BUFFER_SIZE",
        "IDLE_AFTER_MS",
        "CLOSE_AFTER_MS",
        "MAX_BUFFERED_BYTES",
        "PRESENCE_GRACE_MS",
        "LOG_LEVEL",
        "SESSION_COUNT",
        "EVENT_RATE",
        "ERROR_RATE",
        "SEED",
        "AI_SERVICE_URL",
        "AI_SERVICE_PORT",
        "AI_SERVICE_HOST",
        "AI_PROVIDER",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENAI_BASE_URL",
        "AI_FIRST_TOKEN_TIMEOUT_MS",
        "AI_TOTAL_TIMEOUT_MS",
        "AI_MOCK_TOKEN_MS",
        "AI_MOCK_FIRST_TOKEN_MS",
        "AI_SLOW_TOKEN_MS",
        "AI_MAX_CONCURRENT_STREAMS",
        "AI_DEBUG"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "CLIENT_DEV_PORT",
        "PUBLIC_GATEWAY_URL",
        "GATEWAY_HTTP_URL",
        "SSR_TIMEOUT_MS",
        "SSR_DATA_BUDGET_MS",
        "GATEWAY_PORT",
        "GATEWAY_HOST",
        "REPLAY_BUFFER_SIZE",
        "IDLE_AFTER_MS",
        "CLOSE_AFTER_MS",
        "MAX_BUFFERED_BYTES",
        "PRESENCE_GRACE_MS",
        "LOG_LEVEL",
        "SESSION_COUNT",
        "EVENT_RATE",
        "ERROR_RATE",
        "SEED",
        "AI_SERVICE_URL",
        "AI_SERVICE_PORT",
        "AI_SERVICE_HOST",
        "AI_PROVIDER",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENAI_BASE_URL",
        "AI_FIRST_TOKEN_TIMEOUT_MS",
        "AI_TOTAL_TIMEOUT_MS",
        "AI_MOCK_TOKEN_MS",
        "AI_MOCK_FIRST_TOKEN_MS",
        "AI_SLOW_TOKEN_MS",
        "AI_MAX_CONCURRENT_STREAMS",
        "AI_DEBUG"
      ]
    }
  }
}
