{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // NodeNext enforces explicit `.ts` extensions on relative imports, which Node's
    // native type stripping requires at runtime.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  }
}
